includes:
    - ./vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - app
        - database
        - routes
        - tests
    excludePaths:
        - vendor
    # Pest mengikat closure test ke TestCase saat runtime; Larastan tidak
    # dapat menyimpulkan $this di dalam closure it()/test().
    ignoreErrors:
        - '#Call to an undefined method Pest\\PendingCalls\\TestCall::(actingAs|assertAuthenticated|assertAuthenticatedAs|assertGuest|assertEquals|postJson|getJson|deleteJson|get|withSession|withHeader|seed|withoutVite|travel|artisan)\(\)#'
        - '#Access to an undefined property Pest\\PendingCalls\\TestCall::\$(app|school|user|keuangan|kesiswaan|ta|admin|rombel|guru|mapel|semester|komponen|siswa|period|feeType|fee|jenis|book|kategori|nasi|teh|wali|akunSiswa|akunOrtu)#'
        - '#Unable to resolve the template type T(Key|Value) in call to function collect#'
